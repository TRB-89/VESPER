# VESPER v2.1 Environment Configuration Template
# Copy this file to .env and fill in your credentials if available.
# NOTE: .env is git-ignored and must NEVER be committed.

# Zerodha Kite Connect API (Optional for Phase 00 probe c)
# If empty/missing, Zerodha Kite probe runs in documentation stub mode.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Request rate limiting configuration (seconds between requests, default: >= 2.0s)
VESPER_RATE_LIMIT_DELAY=2.0
